// careography.h
#ifndef CAREOGRAPHY_H
#define CAREOGRAPHY_H

#include <stdint.h>

// Definimos en Hz las frecuencias de cada nota:
#define NONE    0
#define LEFT    1
#define DOWN    2
#define UP      3
#define RIGHT   4


#include <stdint.h>

#define MAX_NOTES 256 // Tamano maximo de la melodia (puede ampliarse)

// Definicion de struct tipo "Melody Data" (informacion asociada a la melodia completa)
typedef struct {
    const int *notes;   // Pointer que dirige al array de la melodia
    int length;         // Cantidad de notas que tiene el arry
    int tempo;          // Tempo de la melodia
    const char *name;   // Nombre de la melodia
} MelodyData;

// Definicion de struct tipo "Note" (informacion asociada a cada nota)
typedef struct {
    uint32_t frequency; // Frecuencia de la nota
    uint32_t duration;  // Duracion de la nota
} Note;

// Declaraciones externas
extern const MelodyData *available_melodies[]; // Puntero a las melodias disponibles
extern const int NUM_MELODIES;  // Cantidad de melodias

// Funcion base utilizada para la inicializacion de la melodia:
void initialize_melody(const MelodyData *melodyData, Note *melodyArray, int *melodyLength);

#endif
