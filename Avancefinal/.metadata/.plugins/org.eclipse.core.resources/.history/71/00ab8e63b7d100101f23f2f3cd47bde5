    Status = init_adc(&SpiInstance1, SPI_DEVICE_ID_1);
    if (Status != XST_SUCCESS) {
        xil_printf("Error al iniciar modo SPI (ADC)\r\n");
        return XST_FAILURE;
    }

    // -------------------- I2C --------------------
    Status = init_IIC();
    if (Status != XST_SUCCESS) {
        xil_printf("Error al iniciar modo I2C \r\n");
        return XST_FAILURE;
    }

    // -------------------- LCD --------------------
    xil_printf("Inicializando LCD...\r\n");
