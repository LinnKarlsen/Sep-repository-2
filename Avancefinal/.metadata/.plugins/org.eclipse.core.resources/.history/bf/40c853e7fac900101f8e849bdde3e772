void Animate_Arrow(int current_step, int *pose, int *flag, int *window, int *blocked, int *score, int n){

	uint32_t LEFT_ref  = 1;
	uint32_t DOWN_ref  = 2;
	uint32_t UP_ref    = 3;
	uint32_t RIGHT_ref = 4;

	if(*pose<110){

		if(current_step==LEFT_ref){
			// Left
			GUI_ERASE_LEFT_ARROW(*pose);
			*pose = *pose + n;
			GUI_DRAW_LEFT_ARROW(*pose);
		}else if(current_step==DOWN_ref){
			// Down
			GUI_ERASE_DOWN_ARROW(*pose);
			*pose = *pose + n;
			GUI_DRAW_DOWN_ARROW(*pose);
		}else if(current_step==UP_ref){
			// Up
			GUI_ERASE_UP_ARROW(*pose);
			*pose = *pose + n;
			GUI_DRAW_UP_ARROW(*pose);
		}else if(current_step==RIGHT_ref){
			// Right
			GUI_ERASE_RIGHT_ARROW(*pose);
			*pose = *pose + n;
			GUI_DRAW_RIGHT_ARROW(*pose);
		}

	} else{
		if(current_step==LEFT_ref){
			// Left
			GUI_ERASE_LEFT_ARROW(*pose);
			*pose = -15;
			*flag = 0;
			//GUI_DRAW_LEFT_ARROW(*pose);
		}else if(current_step==DOWN_ref){
			// Down
			GUI_ERASE_DOWN_ARROW(*pose);
			*pose = -15;
			*flag = 0;
			//GUI_DRAW_DOWN_ARROW(*pose);
		}else if(current_step==UP_ref){
			// Up
			GUI_ERASE_UP_ARROW(*pose);
			*pose = -15;
			*flag = 0;
			//GUI_DRAW_UP_ARROW(*pose);
		}else if(current_step==RIGHT_ref){
			// Right
			GUI_ERASE_RIGHT_ARROW(*pose);
			*pose = -15;
			*flag = 0;
			//GUI_DRAW_RIGHT_ARROW(*pose);
		}
	}

	if(*pose>98){
		// Activamos el window a partir de este valor
		*window = 1;
		Check_score(int &score, int *window, int &blocked);
	}

	if(*pose=-15){
		// Reseteamos el window y blocked
		*window = 0;
		*blocked = 0;
	}
}

void Check_score(int *score, int window, int *blocked){
	if(window){
		if(blocked!=1){
			*score = *score + 100;
			*blocked=1;
		}
	}
}
